# 이 파일을 복사해서 같은 폴더에 .env로 저장한 뒤 값을 채워 주세요.
#   cp .env.example .env
# .env는 .gitignore에 포함되어 있으므로 커밋되지 않습니다.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/ubicollab
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 (HS256, 32바이트 이상의 임의 문자열)
# 예: openssl rand -base64 48
JWT_SECRET=

# 비밀번호 해싱용 pepper: BCrypt(HMAC-SHA256(password, pepper))
# 설정 후 변경하면 기존 사용자는 로그인할 수 없습니다.
PASSWORD_PEPPER=

# AWS (S3 업로드, Rekognition 이미지 검열에 사용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# CloudFront 도메인 (https:// 없이 도메인만)
# 예: d1234abcd.cloudfront.net
CLOUDFRONT_DOMAIN=
